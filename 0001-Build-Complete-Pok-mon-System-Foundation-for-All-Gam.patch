+                "accuracy": 100,
+                "priority": 0,
+                "target": "single"
+            }
+        }
+
+def load_abilities() -> Dict[str, Dict[str, Any]]:
+    """Load ability data from JSON"""
+    try:
+        with open(DATA_DIR / "abilities.json", "r") as f:
+            return json.load(f)
+    except FileNotFoundError:
+        # Return minimal ability data
+        return {
+            "static": {
+                "id": 9,
